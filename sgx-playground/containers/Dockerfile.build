FROM docker.io/library/ubuntu:24.04@sha256:c35e29c9450151419d9448b0fd75374fec4fff364a27f176fb458d472dfc9e54 AS build

    ARG DCAP_VERSION=DCAP_1.23

    RUN echo 'deb [signed-by=/etc/apt/keyrings/intel-sgx-keyring.asc arch=amd64] https://download.01.org/intel-sgx/sgx_repo/ubuntu noble main' \
        | tee /etc/apt/sources.list.d/intel-sgx.list

    RUN apt-get update && apt-get -y install build-essential python-is-python3 curl

    RUN mkdir -p /etc/apt/keyrings && \
        curl https://download.01.org/intel-sgx/sgx_repo/ubuntu/intel-sgx-deb.key | tee /etc/apt/keyrings/intel-sgx-keyring.asc

    # Versioned path: latest/linux-latest moved on to 2.30 and 404s for 2.26.
    RUN curl -fsSLo sgx_linux_x64_sdk.bin \
        https://download.01.org/intel-sgx/sgx-linux/2.26/distro/ubuntu24.04-server/sgx_linux_x64_sdk_2.26.100.0.bin

    RUN chmod +x sgx_linux_x64_sdk.bin

    RUN ./sgx_linux_x64_sdk.bin --prefix=/opt/intel

    RUN apt-get update && apt-get -y install libsgx-epid libsgx-quote-ex libsgx-dcap-ql libsgx-dcap-ql-dev libsgx-dcap-default-qpl-dev

FROM build AS verify

    RUN apt-get update && apt -y install python3-pip git cargo && pip install --break-system-packages uv
